{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bootstrap-sha": "45856542a75d2ac69dab2cbe72dc64a6dadb130d",
  "bump-minor-pre-major": true,
  "include-component-in-tag": true,
  "include-v-in-tag": false,
  "pull-request-title-pattern": "chore: release ${version}",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "revert", "section": "Reverts" },
    { "type": "docs", "section": "Documentation" },
    { "type": "deps", "section": "Dependencies" },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Miscellaneous", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true }
  ],
  "packages": {
    ".": {
      "component": "nebari-apps",
      "package-name": "nebari-apps",
      "extra-files": [
        "charts/nebari-apps/Chart.yaml",
        "api/src/nebari_apps_api/__init__.py",
        "mcp/src/nebari_apps_mcp/__init__.py",
        { "type": "json", "path": "ui/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "ui/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "ui/package-lock.json", "jsonpath": "$.packages[''].version" }
      ]
    }
  }
}
